{
  "name": "opencommit",
  "version": "2.0.0",
  "description": "GPT CLI to auto-generate impressive commits in 1 second. Killing lame commits with AI 🤯🔫",
  "keywords": [
    "git",
    "chatgpt",
    "gpt",
    "ai",
    "openai",
    "opencommit",
    "aicommit",
    "aicommits",
    "gptcommit",
    "commit"
  ],
  "main": "cli.js",
  "bin": {
    "opencommit": "./out/cli.cjs",
    "oc": "./out/cli.cjs",
    "oco": "./out/cli.cjs"
  },
  "repository": "https://github.com/di-sukharev/opencommit",
  "type": "module",
  "author": "https://github.com/di-sukharev",
  "license": "MIT",
  "files": [
    "out/**/*"
  ],
  "release": {
    "branches": [
      "master"
    ]
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "watch": "npm run -S build -- --sourcemap --watch",
    "start": "node ./out/cli.cjs",
    "dev": "ts-node ./src/cli.ts",
    "build-only": "rimraf out && node esbuild.config.js",
    "build": "npm run build-only && npm run pkg && npm run sign-and-install",
    "build-linux": "npm run build-only && npm run pkg-linux",
    "distribute": "npm run pack && npm i -g opencommit-v2.0.0.tgz && mv opencommit-v2.0.0.tgz pack/",
    "pkg": "pkg -t node18-macos-arm64 .",
    "pkg-linux": "pkg -t node18-linuxstatic-x64 .",
    "pkg-linux-arm64": "pkg -t node18-linuxstatic-arm64 .",
    "pkg-windows": "pkg -t node18-win32-x64 .",
    "sign-and-install": "codesign --force --deep --sign - opencommit && mv opencommit /opt/homebrew/bin/",
    "deploy": "npm run build && npm version patch && npm publish --tag latest",
    "lint": "eslint src --ext ts && tsc --noEmit",
    "format": "prettier --write src"
  },
  "devDependencies": {
    "@types/ini": "^1.3.31",
    "@types/inquirer": "^9.0.3",
    "@types/node": "^16.18.14",
    "@typescript-eslint/eslint-plugin": "^5.45.0",
    "@typescript-eslint/parser": "^5.45.0",
    "dotenv": "^16.0.3",
    "esbuild": "^0.15.18",
    "eslint": "^8.28.0",
    "prettier": "^2.8.4",
    "ts-node": "^10.9.1",
    "typescript": "^4.9.3"
  },
  "dependencies": {
    "@clack/prompts": "^0.6.1",
    "@dqbd/tiktoken": "^1.0.2",
    "axios": "^1.3.4",
    "beepbeep": "^1.3.0",
    "chalk": "^5.2.0",
    "cleye": "^1.3.2",
    "execa": "^7.0.0",
    "ignore": "^5.2.4",
    "ini": "^3.0.1",
    "inquirer": "^9.1.4",
    "openai": "^3.3.0",
    "simple-git": "^3.17.0"
  },
  "volta": {
    "node": "18.18.2"
  }
}
